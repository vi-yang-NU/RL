# Python
.venv/
__pycache__/
*.pyc

# Job logs and training checkpoints (figures and JSON results are kept for the report)
logs/
results/**/*.pt
results/**/progress.jsonl

# Your settings, written by setup.sh / the dashboard (NetID, default server, key path): never committed.
# .env is where they live now (.env.example lists the variables); config/deepdish.local.json is the older place.
.env
config/deepdish.local.json
config/*.local.json

# Credentials never belong in the repository: passwords are typed into the dashboard and SSH keys stay in ~/.ssh
.streamlit/secrets.toml
*.pem
*.key
id_rsa*
id_ed25519*

.DS_Store
