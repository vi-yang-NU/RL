# Deepdish connection settings. Copy this file to .env (git ignores .env and it is never uploaded to the
# server) and fill in what differs for you, or let ./setup.sh and the dashboard write it. Every variable
# here can also be set in the environment (a VS Code launch configuration, a CI secret, a cloud session's
# environment settings): the environment takes precedence over .env, which takes precedence over
# config/deepdish.local.json and config/deepdish.json. `python run.py deepdish` prints the values in use
# and where each one comes from.

# Your Northwestern NetID (the ssh user).
DEEPDISH_USER=netid

# Which of deepdish1..5 the dashboard and `python run.py deepdish` use unless told otherwise.
DEEPDISH_DEFAULT_SERVER=1

# Where the project lives on the server.
DEEPDISH_REMOTE_DIR=~/RL

# An SSH key to offer besides those ~/.ssh/config names (needed on a machine without the deepdish aliases).
# Passwords are never stored: type yours in the dashboard or at the prompt of `python run.py deepdish --connect`.
#DEEPDISH_IDENTITY_FILE=~/.ssh/id_ed25519

# Rarely needed: the servers and their names, the shared-connection socket and its lifetime, the connect timeout.
#DEEPDISH_SERVERS=1,2,3,4,5
#DEEPDISH_ALIAS_TEMPLATE=deepdish{n}
#DEEPDISH_HOST_TEMPLATE=mlds-deepdish{n}.ads.northwestern.edu
#DEEPDISH_CONTROL_PATH=~/.ssh/cm-%C
#DEEPDISH_CONTROL_PERSIST=4h
#DEEPDISH_CONNECT_TIMEOUT=10
